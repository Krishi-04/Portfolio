{
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.@(html|css|js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
